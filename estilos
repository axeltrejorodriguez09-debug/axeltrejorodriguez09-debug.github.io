body {
    font-family: Verdana, Geneva, Tahoma, sans-serif;
    font-size: 18px;
    margin: 50px;
    line-height: 2.0;
    letter-spacing: 0.5px;
    word-spacing: 2px;
}

h1 {
    font-family: Verdana, Geneva, Tahoma, sans-serif;
    font-size: 40px;
    font-weight: bold;
    text-align: center;
    margin: 35px;
    padding: 25px;
    letter-spacing: 2px;
    word-spacing: 5px;
}

h2 {
    font-family: Verdana, Geneva, Tahoma, sans-serif;
    font-size: 26px;
    font-weight: bold;
    text-align: left;
    letter-spacing: 1.5px;
    word-spacing: 4px;
    line-height: 1.3;
    margin-top: 40px;
    margin-bottom: 15px;
    padding-bottom: 8px;
    text-transform: uppercase;
}

p {
    font-family: Verdana, Geneva, Tahoma, sans-serif;
    font-size: 17px;
    text-align: justify;
    line-height: 1.8;
    letter-spacing: 0.3px;
    word-spacing: 1px;
    margin: 15px 0;
    padding: 5px 10px;
}

ul {
    font-family: Verdana, Geneva, Tahoma, sans-serif;
    font-size: 17px;
    margin: 25px 0 25px 50px;
    padding: 15px 20px;
    letter-spacing: 0.4px;
    word-spacing: 1.5px;
    line-height: 1.8;
    list-style: none;
}

ol {
    font-family: Verdana, Geneva, Tahoma, sans-serif;
    font-size: 17px;
    margin: 25px 0 25px 50px;
    padding: 15px 20px;
    letter-spacing: 0.4px;
    word-spacing: 1.5px;
    line-height: 1.8;
    list-style: none;
}

li {
    font-size: 16px;
    margin: 10px 0;
    letter-spacing: 0.3px;
    word-spacing: 1px;
}

img {
    display: block;
    margin: 20px auto;
    max-width: 500px;
    width: 100%;
    border-radius: 15px;
}

a {
    font-size: 17px;
    font-weight: bold;
    text-decoration: none;
    letter-spacing: 0.5px;
    padding: 3px 6px;
}

a:hover {
    font-size: 19px;
    text-decoration: underline;
    font-weight: bolder;
    background-color: #e0e0e0;
    border-radius: 5px;
}

footer {
    text-align: center;
    margin-top: 50px;
    padding: 25px;
    border-top: 3px solid #000;
    font-size: 14px;
    letter-spacing: 1px;
    line-height: 1.6;
}